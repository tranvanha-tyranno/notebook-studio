{
  "@jupyterlab/apputils-extension:themes": {
    "theme": "JupyterLab Light",
    "adaptive-theme": false,
    "theme-scrollbars": true,
    "overrides": {
      "ui-font-family": "'Segoe UI Variable', 'Segoe UI', Arial, sans-serif",
      "content-font-family": "'Segoe UI Variable', 'Segoe UI', Arial, sans-serif",
      "code-font-family": "'Cascadia Code', 'Cascadia Mono', Consolas, monospace",
      "code-font-size": "14px",
      "content-font-size1": "15px",
      "ui-font-size1": "13px"
    }
  },
  "@jupyterlab/notebook-extension:tracker": {
    "codeCellConfig": {"lineNumbers": true, "lineWrap": true},
    "recordTiming": true,
    "autoRenderMarkdownCells": true,
    "scrollPastEnd": false
  }
}
